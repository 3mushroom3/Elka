# Скопируйте в .env на сервере и заполните. Файл .env никому не передавайте.

# Адрес сайта без https:// (домен должен указывать на IP сервера)
DOMAIN=elka.example.ru

# Пароли базы данных: придумайте два длинных разных пароля (только латинские буквы и цифры)
POSTGRES_PASSWORD=
ELKA_DB_PASSWORD=

# Первый вход главного менеджера. Используется один раз, при создании аккаунта.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Токен Telegram-бота от @BotFather. Можно оставить пустым и добавить позже.
TELEGRAM_BOT_TOKEN=
